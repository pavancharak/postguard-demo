# Copy this file to .env.local (gitignored) and fill in a real key.
# Get an AI Gateway API key at https://vercel.com/[team]/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# Optional: override the default model (must be a valid AI Gateway model id,
# e.g. run `curl https://ai-gateway.vercel.sh/v1/models` to see options).
# AI_MODEL=anthropic/claude-haiku-4.5
